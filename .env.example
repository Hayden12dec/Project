# AI-Based Smart Examination Proctoring System - Environment Configuration

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (MongoDB URI with auto-fallback to local resilient storage)
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=smart_proctor_db

# Security & JWT
JWT_SECRET_KEY=smart_proctoring_super_secret_jwt_key_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# AI Proctoring Config & Suspicion Weights
WEIGHT_FACE_NOT_DETECTED=20
WEIGHT_MULTIPLE_PERSONS=40
WEIGHT_MOBILE_PHONE=50
WEIGHT_SUSPICIOUS_HEAD_MOVEMENT=10
WEIGHT_AUDIO_ACTIVITY=20
WEIGHT_STUDENT_ABSENT=30

# Thresholds & Cooldowns
HEAD_POSE_YAW_THRESHOLD=25.0
